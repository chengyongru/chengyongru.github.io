---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import Terminal from '../../components/Terminal';
import config from '../../config';
import { isPublishablePost } from '../../utils/publication';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.filter(post => isPublishablePost(post)).map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = post.data.title || post.id;
const description = `Notes${post.data.tags.length > 0 ? ` · ${post.data.tags.join(', ')}` : ''}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const dateStr = post.data.date?.toISOString().split('T')[0] || '';
---

<BaseLayout title={`${title} | ${config.site.title}`} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {dateStr && <meta property="article:published_time" content={dateStr} />}
    {post.data.tags.map(tag => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </Fragment>
  <Terminal client:idle />
  <!-- Hidden article for SEO crawlers (rendered server-side) -->
  <article class="prose sr-only">
    <header class="post-header">
      <h1>{post.data.title || post.id}</h1>
      {post.data.date && (
        <div class="post-meta">
          <span class="meta-date">{post.data.date.toISOString().split('T')[0]}</span>
          {post.data.tags.length > 0 && (
            <span class="meta-tags">
              {post.data.tags.map(tag => (
                <span class="tag-badge">{tag}</span>
              ))}
            </span>
          )}
        </div>
      )}
    </header>
    <Content />
  </article>
</BaseLayout>

<script>
import { initBackground } from '../../components/Background';
initBackground();
</script>

<style>
  /* Hidden from visual display but available to crawlers */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .prose {
    max-width: 800px;
    margin: 0 auto;
    padding: 32px 24px;
  }

  .post-header {
    margin-bottom: 2em;
    padding-bottom: 1em;
    border-bottom: 1px solid color-mix(in srgb, var(--surface1) 40%, transparent);
  }

  .post-header h1 {
    color: var(--green);
    font-size: 1.6em;
    margin-bottom: 0.5em;
    letter-spacing: -0.01em;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .meta-date {
    color: var(--subtext);
    font-size: 0.85em;
  }

  .meta-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .tag-badge {
    background: color-mix(in srgb, var(--peach) 10%, transparent);
    color: var(--peach);
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.8em;
    border: 1px solid color-mix(in srgb, var(--peach) 15%, transparent);
  }
</style>
