---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = post.data.title || post.id;
const description = `笔记 by ChengYongru${post.data.tags.length > 0 ? ` · ${post.data.tags.join(', ')}` : ''}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const dateStr = post.data.date?.toISOString().split('T')[0] || '';
---

<BaseLayout title={`${title} | ChengYongru`} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {dateStr && <meta property="article:published_time" content={dateStr} />}
    {post.data.tags.map(tag => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </Fragment>
  <article class="prose">
    <header class="post-header">
      <h1>{post.data.title || post.id}</h1>
      {post.data.date && (
        <div class="post-meta">
          <span class="meta-date">{post.data.date.toISOString().split('T')[0]}</span>
          {post.data.tags.length > 0 && (
            <span class="meta-tags">
              {post.data.tags.map(tag => (
                <span class="tag-badge">{tag}</span>
              ))}
            </span>
          )}
        </div>
      )}
    </header>
    <Content />
    <footer class="post-footer">
      <a href="/">[ back to terminal ]</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .prose {
    max-width: 800px;
    margin: 0 auto;
    padding: 32px 24px;
    color: var(--text);
    line-height: 1.7;
    font-size: 15px;
  }

  .post-header {
    margin-bottom: 2em;
    padding-bottom: 1em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .post-header h1 {
    color: var(--green);
    font-size: 1.6em;
    margin-bottom: 0.5em;
    letter-spacing: -0.01em;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .meta-date {
    color: var(--subtext);
    font-size: 0.85em;
  }

  .meta-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .tag-badge {
    background: rgba(250, 179, 135, 0.1);
    color: var(--peach);
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.8em;
    border: 1px solid rgba(250, 179, 135, 0.15);
  }

  .post-footer {
    margin-top: 3em;
    padding-top: 1em;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    text-align: center;
  }

  .post-footer a {
    color: var(--subtext);
    font-size: 0.85em;
    transition: color 0.15s;
  }

  .post-footer a:hover {
    color: var(--accent);
  }
</style>
